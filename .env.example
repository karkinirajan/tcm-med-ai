# Copy to .env and fill in. Nothing is required to start the server: an endpoint whose services
# are not configured answers 503 and names the missing variables.

# OpenAI: symptom extraction and the embeddings used for the vector search
OPENAI_API_KEY=sk-demo-replace-me
OPENAI_MODEL=demo-chat-model          # a chat model your account can use; no default on purpose
EMBEDDING_MODEL=                      # empty: LangChain's default, which the index was built with
OPENAI_TIMEOUT=60

# Pinecone
PINECONE_API_KEY=pc-demo-replace-me
PINECONE_INDEX_NAME=evidgpt
SYNDROMES_NAMESPACE=syndromes
PRESCRIPTIONS_NAMESPACE=fangji
SYNDROME_CANDIDATES=30
PRESCRIPTION_CANDIDATES=50

# Cohere
COHERE_API_KEY=co-demo-replace-me
COHERE_RERANK_MODEL=demo-rerank-model # a rerank model your account can use; no default on purpose
RERANK_TOP_N=5

# MongoDB Atlas (needs an Atlas Search autocomplete index on the disease-name field)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DATABASE=cmedai
MONGODB_COLLECTION=教科书
MONGODB_SEARCH_INDEX=diseaseName

# The service
HOST=127.0.0.1                        # 0.0.0.0 inside a container (the image sets it)
PORT=8000
API_KEY=                              # when set, callers must send it as X-API-Key
CORS_ORIGINS=                         # comma-separated; no CORS headers when empty
